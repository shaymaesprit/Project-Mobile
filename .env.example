# ==============================================================================
# 🔑 StudyMate — Configuration commune des clés API (Partagée avec votre binôme)
# ==============================================================================
# Copiez ce fichier sous le nom ".env" à la racine :
#   cp .env.example .env
# Puis lancez la synchronisation :
#   python sync_env.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. Backend & Base de données (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://studymate:studymate_local@localhost:5433/studymate
APP_NAME=StudyMate API
APP_VERSION=0.3.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AI_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 📍 1bis. Rappels et recherche de lieux
# ------------------------------------------------------------------------------
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=30
# Options pour PLACES_PROVIDER : photon (OpenStreetMap gratuit sans clé) | geoapify | google
PLACES_PROVIDER=photon
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 🤖 2. Intelligence Artificielle (OpenAI / Gemini / Groq)
# ------------------------------------------------------------------------------
# Options : "openai" ou "none"
LLM_PROVIDER=openai
LLM_API_KEY=votre_cle_api_openai_ou_compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------------------
# 🔥 3. Firebase (Backend & Mobile)
# ------------------------------------------------------------------------------
# Identifiant de votre projet Firebase
FIREBASE_PROJECT_ID=studymate-8930d
# Chemin vers votre clé admin (optionnel en local)
GOOGLE_APPLICATION_CREDENTIALS=

# Clés de configuration de l'application cliente Firebase (trouvables dans Firebase Console > Paramètres du projet > Vos applications)
STUDYMATE_FIREBASE_API_KEY=AIzaSy...
STUDYMATE_FIREBASE_APP_ID=1:406992456210:android:f0189e87cc8c19f67a26cb
STUDYMATE_FIREBASE_PROJECT_ID=studymate-8930d
STUDYMATE_FIREBASE_SENDER_ID=406992456210
STUDYMATE_FIREBASE_STORAGE_BUCKET=studymate-8930d.firebasestorage.app
STUDYMATE_GOOGLE_SERVER_CLIENT_ID=votre_client_id_oauth_web

# ------------------------------------------------------------------------------
# 📱 4. URL de l'API pour l'application Mobile Flutter
# ------------------------------------------------------------------------------
# Sur émulateur Android : http://10.0.2.2:8000/api/v1
# Sur téléphone réel ou navigateur Web : http://VOTRE_IP_LOCALE:8000/api/v1
STUDYMATE_API_URL=http://10.0.2.2:8000/api/v1

# ------------------------------------------------------------------------------
# ☁️ 5. Cloudinary (Photos de profil - Optionnel)
# ------------------------------------------------------------------------------
STUDYMATE_CLOUDINARY_CLOUD_NAME=
STUDYMATE_CLOUDINARY_API_KEY=
STUDYMATE_CLOUDINARY_API_SECRET=
